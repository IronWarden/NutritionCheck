# Copy to supabase/functions/.env for local runs, or set with `supabase secrets set` when deployed.
# Never put these in the mobile app.
ANTHROPIC_API_KEY=sk-ant-...
# Free key from https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY is used if unset, but it is heavily rate limited).
USDA_API_KEY=
# Optional model overrides.
# CLAUDE_MAIN_MODEL=claude-sonnet-5-5
# CLAUDE_FAST_MODEL=claude-haiku-5-5
# CLAUDE_PHOTO_MODEL=claude-haiku-5-5
